From 575307b1713b6df28e4dbef516272441347bff8c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Thorbj=C3=B8rn=20Ravn=20Andersen?= <tra@ravnand.dk>
Date: Mon, 2 Nov 2026 11:08:34 +0100
Subject: [PATCH 3/4] [Z80] Add llvm.z80.im0/im1/im2 and llvm.z80.set.i
 intrinsics

IM 0/1/2 and LD I,A had no intrinsic.  Add llvm.z80.im0, im1, im2 (three
separate intrinsics, matching z88dk's intrinsic_im_0/1/2) and
llvm.z80.set.i(i8) (LD I,A).  All are IntrNoMem + IntrHasSideEffects (full
compiler barriers) + IntrNoCallback + IntrWillReturn, so they do not cost a
function its static frame.  TableGen turns '_' in the def name into '.', so
int_z80_set_i is spelled llvm.z80.set.i in IR.

LD_I_A gets Uses = [A].  Without it the COPY of the value into A looked dead
and was deleted, so LD I,A used whatever A held (the root cause of the
historic set_i failure noted in compat.h).

New lit test intrinsics-im-set-i.ll (MIR + asm; constant, argument-in-A and
argument-not-in-A cases); static-frames-intrinsics.ll now also calls im2 and
set.i from a static-frame function.  Removing Uses = [A] makes the MIR check
in the new test fail.  llvm-objdump: ed 46/56/5e, ed 47.

Tests: llvm-lit CodeGen/Z80 159/160 (z88dk-runtime.ll fails identically on the
base da06bcd8acc2); cargo runtime 462 total / 456 pass / 0 fail / 6 skip,
per-test results identical to the base.

Rules-checked: lit test added; both test tiers run before/after; local branch,
not pushed.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 llvm/include/llvm/IR/IntrinsicsZ80.td         | 15 +++++
 llvm/lib/Target/Z80/Z80InstrInfo.td           |  2 +-
 .../lib/Target/Z80/Z80InstructionSelector.cpp | 25 ++++++++
 llvm/lib/Target/Z80/Z80LegalizerInfo.cpp      |  4 ++
 llvm/test/CodeGen/Z80/intrinsics-im-set-i.ll  | 62 +++++++++++++++++++
 .../CodeGen/Z80/static-frames-intrinsics.ll   |  6 +-
 6 files changed, 112 insertions(+), 2 deletions(-)
 create mode 100644 llvm/test/CodeGen/Z80/intrinsics-im-set-i.ll

diff --git a/llvm/include/llvm/IR/IntrinsicsZ80.td b/llvm/include/llvm/IR/IntrinsicsZ80.td
index a487bec8aa9b..4c3074a310a2 100644
--- a/llvm/include/llvm/IR/IntrinsicsZ80.td
+++ b/llvm/include/llvm/IR/IntrinsicsZ80.td
@@ -57,6 +57,21 @@ let TargetPrefix = "z80" in {  // All intrinsics start with "llvm.z80."
   def int_z80_ei : Intrinsic<[], [], [IntrNoMem, IntrHasSideEffects,
                                       IntrNoCallback]>;
 
+  // Interrupt mode: IM 0 / IM 1 / IM 2
+  // void @llvm.z80.im0(), im1(), im2()
+  def int_z80_im0 : Intrinsic<[], [], [IntrNoMem, IntrHasSideEffects,
+                                       IntrNoCallback, IntrWillReturn]>;
+  def int_z80_im1 : Intrinsic<[], [], [IntrNoMem, IntrHasSideEffects,
+                                       IntrNoCallback, IntrWillReturn]>;
+  def int_z80_im2 : Intrinsic<[], [], [IntrNoMem, IntrHasSideEffects,
+                                       IntrNoCallback, IntrWillReturn]>;
+
+  // Load the interrupt vector base register: LD I,A
+  // void @llvm.z80.set.i(i8 page)   (TableGen turns _ into . in the name)
+  def int_z80_set_i : Intrinsic<[], [llvm_i8_ty],
+                                [IntrNoMem, IntrHasSideEffects, IntrNoCallback,
+                                 IntrWillReturn]>;
+
   // No operation (useful for timing loops)
   // void @llvm.z80.nop()
   def int_z80_nop : Intrinsic<[], [], [IntrNoMem, IntrHasSideEffects,
diff --git a/llvm/lib/Target/Z80/Z80InstrInfo.td b/llvm/lib/Target/Z80/Z80InstrInfo.td
index 2cc105ed5ed8..728a1225158d 100644
--- a/llvm/lib/Target/Z80/Z80InstrInfo.td
+++ b/llvm/lib/Target/Z80/Z80InstrInfo.td
@@ -46,7 +46,7 @@ def LD_nnind_A : Inst24<"ld", 0x32, DirectMode> {
 // LD A,I / LD A,R / LD I,A / LD R,A - Special registers (ED prefix)
 def LD_A_I : InstED8<"ld a,i", 0x57>;
 def LD_A_R : InstED8<"ld a,r", 0x5F>;
-def LD_I_A : InstED8<"ld i,a", 0x47>;
+def LD_I_A : InstED8<"ld i,a", 0x47> { let Uses = [A]; }
 def LD_R_A : InstED8<"ld r,a", 0x4F>;
 
 //===----------------------------------------------------------------------===//
diff --git a/llvm/lib/Target/Z80/Z80InstructionSelector.cpp b/llvm/lib/Target/Z80/Z80InstructionSelector.cpp
index 2812fb392e32..5aa0e74ed80b 100644
--- a/llvm/lib/Target/Z80/Z80InstructionSelector.cpp
+++ b/llvm/lib/Target/Z80/Z80InstructionSelector.cpp
@@ -4039,6 +4039,31 @@ bool Z80InstructionSelector::select(MachineInstr &MI) {
       return true;
     }
 
+    case Intrinsic::z80_im0:
+    case Intrinsic::z80_im1:
+    case Intrinsic::z80_im2: {
+      // void @llvm.z80.im{0,1,2}()
+      unsigned Opc = IntrinsicID == Intrinsic::z80_im0   ? Z80::IM_0
+                     : IntrinsicID == Intrinsic::z80_im1 ? Z80::IM_1
+                                                         : Z80::IM_2;
+      BuildMI(MBB, MI, MI.getDebugLoc(), TII.get(Opc));
+      MI.eraseFromParent();
+      return true;
+    }
+
+    case Intrinsic::z80_set_i: {
+      // void @llvm.z80.set_i(i8 page): LD I,A
+      Register ValueReg = MI.getOperand(1).getReg();
+      if (!RBI.constrainGenericRegister(ValueReg, Z80::GR8RegClass, MRI))
+        return false;
+      // LD_I_A reads A; the copy must not look dead (LD_I_A has Uses = [A]).
+      BuildMI(MBB, MI, MI.getDebugLoc(), TII.get(TargetOpcode::COPY), Z80::A)
+          .addReg(ValueReg);
+      BuildMI(MBB, MI, MI.getDebugLoc(), TII.get(Z80::LD_I_A));
+      MI.eraseFromParent();
+      return true;
+    }
+
     default:
       return false;
     }
diff --git a/llvm/lib/Target/Z80/Z80LegalizerInfo.cpp b/llvm/lib/Target/Z80/Z80LegalizerInfo.cpp
index 28d27a84fdd0..006bd8793aa3 100644
--- a/llvm/lib/Target/Z80/Z80LegalizerInfo.cpp
+++ b/llvm/lib/Target/Z80/Z80LegalizerInfo.cpp
@@ -839,6 +839,10 @@ bool Z80LegalizerInfo::legalizeIntrinsic(LegalizerHelper &Helper,
   case Intrinsic::z80_di:
   case Intrinsic::z80_ei:
   case Intrinsic::z80_nop:
+  case Intrinsic::z80_im0:
+  case Intrinsic::z80_im1:
+  case Intrinsic::z80_im2:
+  case Intrinsic::z80_set_i:
     // These intrinsics are legal and will be selected directly
     return true;
 
diff --git a/llvm/test/CodeGen/Z80/intrinsics-im-set-i.ll b/llvm/test/CodeGen/Z80/intrinsics-im-set-i.ll
new file mode 100644
index 000000000000..592008080bd5
--- /dev/null
+++ b/llvm/test/CodeGen/Z80/intrinsics-im-set-i.ll
@@ -0,0 +1,62 @@
+; RUN: llc -mtriple=z80 -O2 -stop-after=instruction-select < %s | FileCheck %s --check-prefix=MIR
+; RUN: llc -verify-machineinstrs -mtriple=z80 -O2 < %s | FileCheck %s
+;
+; llvm.z80.im0/im1/im2 select IM 0/1/2; llvm.z80.set.i selects LD I,A.
+; LD_I_A reads A, so the copy of the value into A must survive: with a
+; constant (or a value that lives outside A) the load of A must be emitted.
+;
+; C equivalent (through the intrinsics):
+;   void modes(void)            { im0(); im1(); im2(); }
+;   void vec_const(void)        { set_i(0x40); }
+;   void vec_arg(u8 page)       { set_i(page); }
+;   void vec_second(u8 a, u8 b) { set_i(b); }      /* b is not in A */
+
+declare void @llvm.z80.im0()
+declare void @llvm.z80.im1()
+declare void @llvm.z80.im2()
+declare void @llvm.z80.set.i(i8)
+
+; MIR-LABEL: name: modes
+; MIR:       IM_0
+; MIR-NEXT:  IM_1
+; MIR-NEXT:  IM_2
+; CHECK-LABEL: _modes:
+; CHECK:       im 0
+; CHECK-NEXT:  im 1
+; CHECK-NEXT:  im 2
+define void @modes() {
+  call void @llvm.z80.im0()
+  call void @llvm.z80.im1()
+  call void @llvm.z80.im2()
+  ret void
+}
+
+; The constant must be loaded into A first; without Uses = [A] on LD_I_A the
+; copy was removed as dead and LD I,A used whatever A happened to hold.
+; MIR-LABEL: name: vec_const
+; MIR:       LD_I_A implicit $a
+; CHECK-LABEL: _vec_const:
+; CHECK:       ld a,64
+; CHECK-NEXT:  ld i,a
+define void @vec_const() {
+  call void @llvm.z80.set.i(i8 64)
+  ret void
+}
+
+; The argument already arrives in A.
+; CHECK-LABEL: _vec_arg:
+; CHECK-NOT:   ld a,
+; CHECK:       ld i,a
+define void @vec_arg(i8 %page) {
+  call void @llvm.z80.set.i(i8 %page)
+  ret void
+}
+
+; The second argument is not in A, so it has to be moved there.
+; CHECK-LABEL: _vec_second:
+; CHECK:       ld a,
+; CHECK-NEXT:  ld i,a
+define void @vec_second(i8 %a, i8 %b) {
+  call void @llvm.z80.set.i(i8 %b)
+  ret void
+}
diff --git a/llvm/test/CodeGen/Z80/static-frames-intrinsics.ll b/llvm/test/CodeGen/Z80/static-frames-intrinsics.ll
index eaa4892af5cd..746be8391173 100644
--- a/llvm/test/CodeGen/Z80/static-frames-intrinsics.ll
+++ b/llvm/test/CodeGen/Z80/static-frames-intrinsics.ll
@@ -12,7 +12,7 @@
 ;
 ; C equivalent of the positive module (through the intrinsics):
 ;   void a(void) { volatile char buf[8]; buf[0] = 1; nop(); }
-;   void b(void) { volatile char buf[8]; buf[0] = 2; }
+;   void b(void) { volatile char buf[8]; buf[0] = 2; im2(); set_i(0x40); }
 ;   int main(void) { volatile int v = 1; port_out(5, port_in(4)); di(); ei();
 ;                    a(); b(); halt(); return v; }
 ;   void isr(void) __attribute__((interrupt)) { volatile int v = 7; ei(); }
@@ -24,6 +24,8 @@ declare void @llvm.z80.halt()
 declare void @llvm.z80.di()
 declare void @llvm.z80.ei()
 declare void @llvm.z80.nop()
+declare void @llvm.z80.im2()
+declare void @llvm.z80.set.i(i8)
 
 define void @a() {
   %buf = alloca [8 x i8], align 1
@@ -35,6 +37,8 @@ define void @a() {
 define void @b() {
   %buf = alloca [8 x i8], align 1
   store volatile i8 2, ptr %buf, align 1
+  call void @llvm.z80.im2()
+  call void @llvm.z80.set.i(i8 64)
   ret void
 }
 
