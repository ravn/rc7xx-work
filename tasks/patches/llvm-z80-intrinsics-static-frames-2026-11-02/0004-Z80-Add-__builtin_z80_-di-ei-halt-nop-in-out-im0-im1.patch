diff --git a/clang/lib/CodeGen/TargetBuiltins/Z80.cpp b/clang/lib/CodeGen/TargetBuiltins/Z80.cpp
new file mode 100644
index 000000000000..043f38082261
--- /dev/null
+++ b/clang/lib/CodeGen/TargetBuiltins/Z80.cpp
@@ -0,0 +1,77 @@
+//===-- Z80.cpp - Emit LLVM Code for Z80 builtins -------------------------===//
+//
+// Part of LLVM-Z80, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file emits Z80 builtin calls as the matching llvm.z80.* intrinsics.
+// ravn/llvm-z80#42.
+//
+//===----------------------------------------------------------------------===//
+
+#include "CodeGenFunction.h"
+#include "clang/Basic/TargetBuiltins.h"
+#include "llvm/IR/IntrinsicsZ80.h"
+
+using namespace clang;
+using namespace CodeGen;
+using namespace llvm;
+
+Value *CodeGenFunction::EmitZ80BuiltinExpr(unsigned BuiltinID,
+                                           const CallExpr *E) {
+  // Each privileged builtin lowers to its side-effecting llvm.z80.* intrinsic.
+  Intrinsic::ID IntID;
+  switch (BuiltinID) {
+  default:
+    return nullptr;
+  case clang::Z80::BI__builtin_z80_di:
+    IntID = Intrinsic::z80_di;
+    break;
+  case clang::Z80::BI__builtin_z80_ei:
+    IntID = Intrinsic::z80_ei;
+    break;
+  case clang::Z80::BI__builtin_z80_halt:
+    IntID = Intrinsic::z80_halt;
+    break;
+  case clang::Z80::BI__builtin_z80_nop:
+    IntID = Intrinsic::z80_nop;
+    break;
+  case clang::Z80::BI__builtin_z80_im0:
+    IntID = Intrinsic::z80_im0;
+    break;
+  case clang::Z80::BI__builtin_z80_im1:
+    IntID = Intrinsic::z80_im1;
+    break;
+  case clang::Z80::BI__builtin_z80_im2:
+    IntID = Intrinsic::z80_im2;
+    break;
+  case clang::Z80::BI__builtin_z80_in: {
+    // unsigned char __builtin_z80_in(unsigned char) -> llvm.z80.in(i8)
+    Value *Port = EmitScalarExpr(E->getArg(0));
+    Function *F =
+        Intrinsic::getOrInsertDeclaration(&CGM.getModule(), Intrinsic::z80_in);
+    return Builder.CreateCall(F, {Port});
+  }
+  case clang::Z80::BI__builtin_z80_out: {
+    // void __builtin_z80_out(unsigned char, unsigned char)
+    //   -> llvm.z80.out(i8 port, i8 value)
+    Value *Port = EmitScalarExpr(E->getArg(0));
+    Value *Val = EmitScalarExpr(E->getArg(1));
+    Function *F =
+        Intrinsic::getOrInsertDeclaration(&CGM.getModule(), Intrinsic::z80_out);
+    return Builder.CreateCall(F, {Port, Val});
+  }
+  case clang::Z80::BI__builtin_z80_set_i: {
+    // void __builtin_z80_set_i(unsigned char) -> llvm.z80.set.i(i8)
+    Value *Val = EmitScalarExpr(E->getArg(0));
+    Function *F =
+        Intrinsic::getOrInsertDeclaration(&CGM.getModule(), Intrinsic::z80_set_i);
+    return Builder.CreateCall(F, {Val});
+  }
+  }
+
+  Function *F = Intrinsic::getOrInsertDeclaration(&CGM.getModule(), IntID);
+  return Builder.CreateCall(F);
+}
diff --git a/clang/test/CodeGen/z80-builtins-sm83-gate.c b/clang/test/CodeGen/z80-builtins-sm83-gate.c
new file mode 100644
index 000000000000..e7d7fc09f260
--- /dev/null
+++ b/clang/test/CodeGen/z80-builtins-sm83-gate.c
@@ -0,0 +1,26 @@
+// RUN: %clang_cc1 -triple z80  -emit-llvm -o /dev/null -verify=z80  %s
+// RUN: %clang_cc1 -triple sm83 -emit-llvm -o /dev/null -verify=sm83 %s
+//
+// ravn/llvm-z80#208: __builtin_z80_im0/1/2 (IM n), __builtin_z80_set_i (LD I,A)
+// and __builtin_z80_in/out (IN/OUT) are Z80-only -- SM83 (Game Boy) has no
+// interrupt modes, no I register and no port instructions.
+// They must be rejected on sm83 with a clean frontend diagnostic (gated on the
+// "z80" target feature), while di/ei/halt/nop stay available on both triples.
+//
+// z80-no-diagnostics
+
+void common(void) {
+  __builtin_z80_di();
+  __builtin_z80_ei();
+  __builtin_z80_halt();
+  __builtin_z80_nop();
+}
+
+void z80_only(void) {
+  __builtin_z80_im0();    // sm83-error {{'__builtin_z80_im0' needs target feature z80}}
+  __builtin_z80_im1();    // sm83-error {{'__builtin_z80_im1' needs target feature z80}}
+  __builtin_z80_im2();    // sm83-error {{'__builtin_z80_im2' needs target feature z80}}
+  (void)__builtin_z80_in(0); // sm83-error {{'__builtin_z80_in' needs target feature z80}}
+  __builtin_z80_out(0, 0);   // sm83-error {{'__builtin_z80_out' needs target feature z80}}
+  __builtin_z80_set_i(0); // sm83-error {{'__builtin_z80_set_i' needs target feature z80}}
+}
diff --git a/clang/test/CodeGen/z80-builtins.c b/clang/test/CodeGen/z80-builtins.c
new file mode 100644
index 000000000000..d54e69f82d99
--- /dev/null
+++ b/clang/test/CodeGen/z80-builtins.c
@@ -0,0 +1,51 @@
+// RUN: %clang_cc1 -triple z80 -emit-llvm -o - %s | FileCheck %s
+//
+// ravn/llvm-z80#42 — the __builtin_z80_* privileged-instruction builtins must
+// lower to their side-effecting llvm.z80.* intrinsics so C code can emit DI/EI/
+// HALT/NOP/IM 0/1/2/LD I,A/IN/OUT without inline assembly (so that they do not
+// cost the function its static frame; see llvm/test/CodeGen/Z80/static-frames-intrinsics.ll).
+
+// CHECK-LABEL: define {{.*}}void @test_di()
+// CHECK: call void @llvm.z80.di()
+void test_di(void) { __builtin_z80_di(); }
+
+// CHECK-LABEL: define {{.*}}void @test_ei()
+// CHECK: call void @llvm.z80.ei()
+void test_ei(void) { __builtin_z80_ei(); }
+
+// CHECK-LABEL: define {{.*}}void @test_halt()
+// CHECK: call void @llvm.z80.halt()
+void test_halt(void) { __builtin_z80_halt(); }
+
+// CHECK-LABEL: define {{.*}}void @test_nop()
+// CHECK: call void @llvm.z80.nop()
+void test_nop(void) { __builtin_z80_nop(); }
+
+// CHECK-LABEL: define {{.*}}void @test_im0()
+// CHECK: call void @llvm.z80.im0()
+void test_im0(void) { __builtin_z80_im0(); }
+
+// CHECK-LABEL: define {{.*}}void @test_im1()
+// CHECK: call void @llvm.z80.im1()
+void test_im1(void) { __builtin_z80_im1(); }
+
+// CHECK-LABEL: define {{.*}}void @test_im2()
+// CHECK: call void @llvm.z80.im2()
+void test_im2(void) { __builtin_z80_im2(); }
+
+// CHECK-LABEL: define {{.*}}void @test_set_i(
+// CHECK: call void @llvm.z80.set.i(i8
+void test_set_i(unsigned char v) { __builtin_z80_set_i(v); }
+
+// CHECK-LABEL: define {{.*}}i8 @test_in(
+// CHECK: call i8 @llvm.z80.in(i8
+unsigned char test_in(unsigned char p) { return __builtin_z80_in(p); }
+
+// CHECK-LABEL: define {{.*}}void @test_out(
+// CHECK: call void @llvm.z80.out(i8 {{.*}}, i8
+void test_out(unsigned char p, unsigned char v) { __builtin_z80_out(p, v); }
+
+// A constant port stays a constant operand of the intrinsic.
+// CHECK-LABEL: define {{.*}}void @test_out_const(
+// CHECK: call void @llvm.z80.out(i8 16, i8
+void test_out_const(unsigned char v) { __builtin_z80_out(16, v); }
