#!/bin/sh
# Pre-commit hook: byte-verifikation af RC759 XIOS og ccpm.sys hvis relevante
# filer er staged. Kører Docker-byg + cmp og afviser commit ved diff.
# Installeret via tasks/rc759-xios/hooks/install.sh
#
# Lærdom 2026-11-24/25 (HANDOFF-2026-11-25.md afsnit 5): byte-perfekthed blev
# brudt i 16 timer fordi verifikation ikke kørte efter en stor refactoring.
# Derfor: ALLE filer der indgår i ccpm.sys- eller XIOS-byggeriet låses her.

ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

# Fil-sæt der udløser henholdsvis XIOS- og ccpm.sys-verifikation.
xios_staged=0
if echo "$STAGED" | grep -E 'tasks/rc759-xios/(xios\.asm|xios_code\.asm|rasm86\.inc|hardware\.inc)$' >/dev/null; then
    xios_staged=1
fi
ccpm_staged=0
if echo "$STAGED" | grep -E 'tasks/rc759-xios/(ccpm\.asm|mod[0-4]_.*\.asm|rsp_.*\.asm|license\.inc)$' >/dev/null; then
    ccpm_staged=1
fi

if [ "$xios_staged" = "0" ] && [ "$ccpm_staged" = "0" ]; then
    exit 0
fi

if ! docker image inspect rc759-nasm >/dev/null 2>&1; then
    echo "FEJL: Docker-image 'rc759-nasm' ikke fundet."
    echo "      Byg det med: docker build -t rc759-nasm tasks/rc759-xios/docker/"
    exit 1
fi

if [ "$xios_staged" = "1" ]; then
    echo "XIOS filer staged — kører byte-verifikation..."
    result=$(docker run --rm \
        -v "$ROOT:/work" \
        -w /work/tasks/rc759-xios \
        rc759-nasm sh -c "
            nasm -f bin -DNUM_VIR_CONS=1 -o /work/scratch/tmp/xios1_hook.bin xios.asm 2>&1 && \
            cmp -s /work/scratch/tmp/xios1_hook.bin /work/tasks/rc759-xios/dist/XIOS1.CON && \
            echo 'XIOS1 MATCH' || echo 'XIOS1 DIFFERS'; \
            nasm -f bin -DNUM_VIR_CONS=4 -o /work/scratch/tmp/xios4_hook.bin xios.asm 2>&1 && \
            cmp -s /work/scratch/tmp/xios4_hook.bin /work/tasks/rc759-xios/dist/XIOS4.CON && \
            echo 'XIOS4 MATCH' || echo 'XIOS4 DIFFERS'
        ")
    echo "$result"
    if echo "$result" | grep -q "DIFFERS\|error\|Error"; then
        echo ""
        echo "COMMIT AFVIST: XIOS byte-verifikation fejlede."
        echo "Verificer manuelt: tasks/rc759-xios/build_and_verify_xios.sh"
        exit 1
    fi
    echo "XIOS byte-verifikation OK."
fi

if [ "$ccpm_staged" = "1" ]; then
    echo "ccpm.asm-filer staged — kører ccpm.sys byte-verifikation..."
    ccpm_result=$(docker run --rm \
        -v "$ROOT:/work" \
        -w /work/tasks/rc759-xios \
        rc759-nasm sh -c "
            nasm -f bin -o /work/scratch/tmp/ccpm_hook.sys ccpm.asm 2>&1 && \
            cmp -s /work/scratch/tmp/ccpm_hook.sys /work/tasks/rc759-xios/dist/ccpm.sys && \
            echo 'CCPM MATCH' || echo 'CCPM DIFFERS'
        ")
    echo "$ccpm_result"
    if echo "$ccpm_result" | grep -q "DIFFERS\|error\|Error"; then
        echo ""
        echo "COMMIT AFVIST: ccpm.sys byte-verifikation fejlede."
        echo "Verificer manuelt: tasks/rc759-xios/rebuild_and_verify.sh"
        exit 1
    fi
    echo "ccpm.sys byte-verifikation OK."
fi

exit 0
