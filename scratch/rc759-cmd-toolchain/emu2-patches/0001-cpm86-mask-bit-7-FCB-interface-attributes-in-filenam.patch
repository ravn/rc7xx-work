From f291d3d070b4ea9c1cb1a1087475c836373c718e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Thorbj=C3=B8rn=20Ravn=20Andersen?= <tra@ravnand.dk>
Date: Thu, 13 Aug 2026 09:39:43 +0200
Subject: [PATCH 1/3] cpm86: mask bit-7 FCB interface attributes in filenames

CP/M-86 carries "interface attributes" in bit 7 of the 8 name and 3 type
bytes of an FCB; they are not part of the filename. Mask them off when
running a CP/M-86 image, otherwise tools that set them (e.g. DR C) get
truncated names such as "SRCFILE" -> "SRCFI".

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/dosnames.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/dosnames.c b/src/dosnames.c
index bc13aa1..f76adab 100644
--- a/src/dosnames.c
+++ b/src/dosnames.c
@@ -2,6 +2,7 @@
 #define _GNU_SOURCE
 
 #include "dosnames.h"
+#include "cpm86.h"
 #include "dbg.h"
 #include "emu.h"
 #include "env.h"
@@ -647,6 +648,12 @@ char *dos_unix_path_fcb(int addr, int force, const char *append)
     }
     // And copy file name
     char *fcb_name = getstr(addr + 1, 11);
+    // CP/M-86 carries "interface attributes" in bit 7 of the 8 name + 3 type
+    // bytes of an FCB; they are not part of the name.  Mask them off, or tools
+    // that set them (e.g. DR C) get truncated names ("SRCFILE" -> "SRCFI").
+    if(cpm86_active)
+        for(int i = 0; i < 11; i++)
+            fcb_name[i] &= 0x7F;
     debug(debug_dos, "\tconvert dos fcb name %c:'%s'\n", drive + 'A', fcb_name);
 
     // Build filename from FCB
