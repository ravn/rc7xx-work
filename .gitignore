cmake-build-debug/
.idea/

# Claude Code session state (plans, memory symlinks, per-machine
# settings.local.json).  Per-user.
# Exceptions: project-level skills + the shared settings.json (which
# wires up project-wide hooks like tasks/hooks/block-icloud-walk.py).
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/settings.json

# MAME auto-saved config (bitbanger paths, slot state).  Regenerated
# every time MAME runs from this cwd.
cfg/

# Unrelated project that landed here as a download cwd.
tinypi-2024-11-04/

# Ad-hoc MAME screenshots saved into the workspace root by various
# capture scripts during debugging sessions.  Per-session, not for tree.
snap/

# Third-party AVR simulator clone used by tasks/upstream-5bug/avr/Makefile
# as a cross-target oracle.  Cloned ad-hoc; not part of our tree.
simavr/

# AVR Makefile build artifacts (cleaned by `make clean` in that dir).
tasks/upstream-5bug/avr/*.elf
tasks/upstream-5bug/avr/*.o
# Compiler-evaluation staging trees (prebuilt oracles, not vendored)
cedev-eval/
xyz-eval/
xyz-fork/

# --- Cleanup 2026-08-18: regenerable artifacts + large media/build staging ---
# CP/M-86 oracle disk images / PFDC media (ground-truth blobs + per-test builds,
# regenerated by the toolchain scripts; ~32 MB, not vendored into the tree).
scratch/rc759-pce/
# Extracted reference-manual text + graphics staging (downloaded/derived).
scratch/rc759-graphics/
# CP/M-86 cross-dev staging: nested crossdev/emu2 clones + build work dir.
scratch/cpm86-tools/
# Prebuilt Info-ZIP / levee CP/M-86 build trees (nested build repos).
infozip-cpm86-builds/
levee-cpm86-builds/
# MAME per-run nvram (regenerated every boot from this cwd).
nvram/
# Compiler/assembler build outputs in the CP/M-86 toolchain scratch area.
scratch/rc759-cmd-toolchain/*.CMD
scratch/rc759-cmd-toolchain/*.o
scratch/rc759-cmd-toolchain/drc86111/cscript
scratch/rc759-cmd-toolchain/drc86111/*.tok
# Ad-hoc build/run logs and Watcom test error dumps.
scratch/*.log
/dhry.err
/whet.err
